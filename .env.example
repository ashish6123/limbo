# Database
DATABASE_URL=postgresql+asyncpg://limbo:limbo@localhost:5432/limbo

# Gateway
GATEWAY_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# GATEWAY_MODE=paypal uses the PayPal sandbox REST API (developer.paypal.com > Apps & Credentials).
# PAYPAL_BASE_URL is locked to the sandbox; live PayPal is rejected at startup.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD
# Where PayPal returns the buyer after approving a /demo order.
PUBLIC_DASHBOARD_URL=http://localhost:3000

# LLM
GEMINI_API_KEY=

# SLA windows
ORDER_FULFILLABLE_WINDOW_MINUTES=30
REFUND_SETTLEMENT_SLA_HOURS=72

# Guardrails
MAX_AUTO_AMOUNT_PAISE=500000
MAX_RETRY_ATTEMPTS=3
CIRCUIT_BREAKER_FALSE_INTERVENTION_RATE=0.02
DRY_RUN=true

# Eval baseline
BASELINE_RESOLUTION_DAYS=21

# Reconciliation
RECON_INTERVAL_SECONDS=60
RUN_EMBEDDED_SCHEDULER=true

# CORS (comma-separated origins)
CORS_ALLOW_ORIGINS=http://localhost:3000

# Dashboard API key (empty = read-only endpoints stay open, for local dev)
DASHBOARD_API_KEY=

# Live demo
DEMO_ORDER_AMOUNT_PAISE=100000
DEMO_MAX_AMOUNT_PAISE=100000
DEMO_SESSION_TTL_MINUTES=30
DEMO_FULFILLABLE_WINDOW_SECONDS=20
DEMO_RATE_LIMIT_PER_MINUTE=10
